# Local development only. Create this database before running migrations.
DATABASE_URL=postgresql://localhost:5432/sandar
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Delivery is local only; no external recipient is contacted.
EMAIL_PROVIDER=development
DEV_EMAIL_DIRECTORY=.local/mail
DEV_INBOX_PORT=8025
# Generated by npm run dev:setup; never commit the real key.
DATA_ENCRYPTION_KEY=
API_INTERNAL_URL=http://127.0.0.1:3001
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001/v1
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000
ENABLE_PAID_PROGRAMS=false
ENABLE_PROFESSIONAL_BOOKING=false
ENABLE_CSR_MATCHING=false
ENABLE_AI_SAFETY_ASSIST=false
# Integration tests require a separate, disposable database ending in _test.
TEST_DATABASE_URL=postgresql://localhost:5432/sandar_test
